# Copy to .env.local and fill in. Never commit .env.local.

# --- Bhashini (ASR / NMT / TTS) ---
BHASHINI_USER_ID=
BHASHINI_API_KEY=
BHASHINI_PIPELINE_ID=

# --- App API (backend) ---
API_PORT=4000
# Supabase, two endpoints on purpose. There is no local Postgres any more.
#
#   DATABASE_URL           :6543  transaction pooler - the API server.
#                                 Short queries, no session state, many clients.
#   MIGRATION_DATABASE_URL :5432  session pooler - `pnpm api:migrate` and the
#                                 import scripts, which hold one connection
#                                 across a whole transaction (DDL, a staging
#                                 table built and read back before COMMIT).
#                                 Falls back to DATABASE_URL when unset.
#
# sslmode=no-verify gives TLS to the pooler without chain verification. Plain
# `sslmode=require` fails: node-pg still treats it as verify-full, and the
# pooler presents a self-signed chain. Do not drop it - without any sslmode the
# connection is unencrypted over the internet.
#
# Note the session pooler, not the Direct connection: Direct is IPv6-only unless
# you buy the IPv4 add-on, and nothing here needs a true direct connection.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=no-verify
MIGRATION_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=no-verify
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
# Signing key for session tokens. Must be >= 32 chars in production.
JWT_SECRET=
JWT_TTL_SECONDS=2592000

# Print the OTP to the API console instead of sending an SMS. Local/demo only -
# the API refuses to boot with this set in production. There is deliberately no
# silent fallback: with this off and no provider key, production will not start.
OTP_DEV_MODE=false
# Return the OTP in the request-otp response. Automated tests only; also
# refused in production, and requires OTP_DEV_MODE=true.
OTP_DEV_ECHO=false
# Use a fixed login code instead of a random one, so local and demo runs do not
# need the server log. Requires OTP_DEV_MODE=true, must be 4 digits, and the API
# refuses to boot with it set in production.
OTP_DEV_FIXED_CODE=
OTP_TTL_SECONDS=300
OTP_PROVIDER_KEY=
OTP_SENDER_ID=UDYAM

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
# Offer the clearly-labelled demo villages when the LGD table is empty.
# Never set this in production - the real list comes from an LGD export via
# `pnpm api:import-villages -- <export.csv>`.
NEXT_PUBLIC_DEMO_VILLAGES=false

