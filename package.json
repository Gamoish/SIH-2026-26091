{
  "name": "udyam-sathi",
  "version": "0.1.0",
  "private": true,
  "description": "Hyper-local business feasibility and government loan-scheme advisor for rural micro-entrepreneurs",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @udyam-sathi/frontend dev",
    "build": "pnpm --filter @udyam-sathi/frontend build",
    "start": "pnpm --filter @udyam-sathi/frontend start",
    "lint": "pnpm --filter @udyam-sathi/frontend lint",
    "format": "pnpm --filter @udyam-sathi/frontend format",
    "format:check": "pnpm --filter @udyam-sathi/frontend format:check",
    "typecheck": "pnpm --filter @udyam-sathi/frontend typecheck && pnpm --filter @udyam-sathi/backend typecheck",
    "test": "pnpm --filter @udyam-sathi/frontend test && pnpm --filter @udyam-sathi/backend test",
    "e2e": "pnpm --filter @udyam-sathi/frontend exec playwright test",
    "db:up": "docker compose -f db/docker-compose.yml up -d db",
    "db:down": "docker compose -f db/docker-compose.yml down",
    "api:dev": "pnpm --filter @udyam-sathi/backend dev",
    "api:migrate": "pnpm --filter @udyam-sathi/backend migrate",
    "api:import-villages": "pnpm --filter @udyam-sathi/backend import:villages",
    "api:import-census": "pnpm --filter @udyam-sathi/backend import:census"
  }
}

