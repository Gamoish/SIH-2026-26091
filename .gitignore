# dependencies
node_modules/
.pnpm-store/

# builds
.next*/
out/
dist/
*.tsbuildinfo
# Regenerated by every `next build`, and it points at whichever distDir
# built last - so it flip-flops between .next and .next-e2e and shows up
# as a diff after every e2e run. Next recreates it on build; nothing needs
# it committed (create-next-app ignores it too).
next-env.d.ts

# test output
test-results/
playwright-report/
blob-report/
playwright/.cache/
# phone numbers the e2e suite minted, consumed by its globalTeardown
.e2e-minted

# environment
.env
.env.local
.env.*.local

# editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# local screenshot scratch
apps/web/shots/

# knowledge-graph tool output (regenerable)
graphify-out/


claude.md